# Copy to .env and fill. Never commit .env.
# This file is committed — keep every value here blank or a placeholder.

# --- LLM providers (chain order: gemini -> nvidia_nim -> openrouter) ---
# Hosted APIs only. There is no local-model fallback: the pipeline's real
# home is CI, where no local daemon is listening.
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=

# Model IDs are config-driven because free models rotate out.
GEMINI_MODEL=gemini-2.0-flash
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Embeddings ---
# nvidia_nim (default) | gemini
#
# The clustering threshold in config/scoring.json is tuned per embedding
# model. Changing this means re-running `airfoil cluster --debug` and
# re-tuning similarity_threshold.
AIRFOIL_EMBEDDER=nvidia_nim
NVIDIA_NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
GEMINI_EMBED_MODEL=text-embedding-004

# --- GitHub ingest (optional, raises rate limit from 60/hr to 5000/hr) ---
GITHUB_TOKEN=

# --- Reddit requires a descriptive User-Agent or it returns 429 ---
REDDIT_USER_AGENT=airfoil/0.1 (by /u/YOUR_USERNAME)

# --- Site ---
SITE_URL=https://airfoil.example.com

# --- Behaviour ---
AIRFOIL_DATA_DIR=./data
AIRFOIL_CONFIG_DIR=./config
AIRFOIL_LOG_LEVEL=info
