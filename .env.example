# Copy to .env and fill. Never commit .env.

# --- LLM providers (chain order: gemini -> openrouter -> ollama) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Model IDs are config-driven because free models rotate out.
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=

# --- Embeddings ---
# ollama (local, default) | gemini (CI)
SCOUTER_EMBEDDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_EMBED_MODEL=text-embedding-004

# --- GitHub ingest (optional, raises rate limit from 60/hr to 5000/hr) ---
GITHUB_TOKEN=

# --- Reddit requires a descriptive User-Agent or it returns 429 ---
REDDIT_USER_AGENT=scouter/0.1 (by /u/YOUR_USERNAME)

# --- Site ---
SITE_URL=https://scouter.example.com

# --- Behaviour ---
SCOUTER_DATA_DIR=./data
SCOUTER_CONFIG_DIR=./config
SCOUTER_LOG_LEVEL=info
