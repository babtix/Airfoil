{
  "$comment": "Tune these against real data. Never guess — run `airfoil rank` and look at the top 20 before changing anything.",

  "clustering": {
    "similarity_threshold": 0.82,
    "window_hours": 48,
    "debug_range": [0.75, 0.90]
  },

  "weights": {
    "sources": 22.0,
    "tier": 25.0,
    "hn": 6.0,
    "reddit": 5.0,
    "builder": 4.0,
    "hype": 6.0
  },

  "tier_weights": {
    "1": 1.00,
    "2": 0.85,
    "3": 0.80,
    "4": 0.50,
    "5": 0.30
  },

  "recency": {
    "half_life_hours": 48
  },

  "caps": {
    "builder_signal_max": 5,
    "hype_signal_max": 5,
    "llm_calls_per_run": 15
  },

  "tiers": {
    "major_min_score": 70,
    "notable_min_score": 40
  },

  "builder_relevant_min_signals": 2,

  "limits": {
    "excerpt_max_chars": 300,
    "summary_max_words": 80,
    "takeaways_max": 3,
    "verbatim_overlap_max_words": 12,
    "quotes_max": 1,
    "quote_max_words": 15
  },

  "retention": {
    "items_days": 30,
    "seen_urls_days": 30,
    "embedding_cache_days": 7
  }
}
